{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server/server.js",
    "local": "dotenv -e .env.development nodemon server/server.js",
    "prod": "dotenv -e .env.production nodemon server/server.js",
    "client": "yarn --cwd client/ start",
    "dev": "concurrently \"yarn run prod\" \"yarn run client\" ",
    "heroku-postbuild": "YARN_PRODUCTION=false yarn --cwd client/ install && yarn --cwd client/ run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.3.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.0"
  },
  "devDependencies": {
    "concurrently": "^7.6.0",
    "nodemon": "^2.0.21"
  },
  "engines": {
    "node": "16.x"
  }
}
